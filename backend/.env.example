# ===========================================
# InFast AI Backend - Environment Variables
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/infastai

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Backend URL (for callbacks)
BACKEND_URL=http://localhost:5000

# ===========================================
# InPay.uz Payment Gateway Configuration
# ===========================================

# Your InPay Merchant Credentials (get from InPay.uz dashboard)
INPAY_MERCHANT_ID=your_merchant_id_here
INPAY_MERCHANT_TOKEN=your_merchant_token_here

# InPay Callback URL (webhook - InPay will POST payment status here)
# For production: https://your-backend-domain.com/api/payments/inpay/callback
INPAY_CALLBACK_URL=http://localhost:5000/api/payments/inpay/callback

# InPay Return URL (user redirected here after payment)
# For production: https://your-frontend-domain.com/payment/success
INPAY_RETURN_URL=http://localhost:5173/payment/success

# ===========================================
# Google OAuth (optional)
# ===========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===========================================
# Email Service (optional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ===========================================
# Telegram Bot (optional)
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
